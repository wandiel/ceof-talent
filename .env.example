# =============================================================================
# CEOF TALENT — variáveis de ambiente
#
# Desenvolvimento: copiar é opcional (há padrões no docker-compose.yml).
# Produção: copie para .env e preencha TODOS os itens marcados [OBRIGATÓRIO].
#           Gere segredos com: ./docker/scripts/generate-secrets.sh
# O arquivo .env NUNCA deve ser versionado.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_NAME="CEOF TALENT"
# local (desenvolvimento) | production. Em produção é fixado pelo compose.
APP_ENV=local
APP_DEBUG=true
# [OBRIGATÓRIO em produção] Em dev, vazio = chave gerada e guardada em storage.
APP_KEY=
# [OBRIGATÓRIO em produção] URL pública, ex.: https://talent.suaempresa.com.br
# Em desenvolvimento deixe vazio: será http://localhost:<APP_PORT>.
APP_URL=
APP_TIMEZONE=America/Manaus
APP_LOCALE=pt_BR
LOG_LEVEL=debug
# Minutos de inatividade até a sessão expirar.
SESSION_LIFETIME=120

# --- Portas no host -----------------------------------------------------------
# Desenvolvimento
APP_PORT=8080
DB_FORWARD_PORT=5432
# Produção
HTTP_PORT=80
HTTPS_PORT=443

# --- Domínio e HTTPS (produção) ----------------------------------------------
# [OBRIGATÓRIO em produção]
SERVER_NAME=talent.suaempresa.com.br
# Diretório com fullchain.pem e privkey.pem
TLS_CERTS_DIR=./docker/nginx/certs

# --- Banco de dados (PostgreSQL) ----------------------------------------------
DB_DATABASE=ceof_talent
DB_USERNAME=ceof_talent
# [OBRIGATÓRIO em produção]
DB_PASSWORD=ceof_talent_dev
# Superusuário do PostgreSQL (usado só na inicialização do volume). [OBRIGATÓRIO em produção]
POSTGRES_SUPERUSER_PASSWORD=ceof_postgres_dev

# --- Redis (cache, sessões e filas) --------------------------------------------
# [OBRIGATÓRIO em produção]
REDIS_PASSWORD=ceof_redis_dev

# --- Inicialização -------------------------------------------------------------
# Executa migrations ao subir o container "app".
RUN_MIGRATIONS=true
# Carrega dados de referência (perfis, permissões). Não cria usuários.
SEED_REFERENCE_DATA=true

# --- Armazenamento de documentos ------------------------------------------------
# local = volume Docker privado | s3 = bucket compatível com S3 (AWS, MinIO, Wasabi...)
# O bucket deve ser PRIVADO. Para migrar de local para s3, ver docs/manuais/implantacao-na-nuvem.md.
# AWS_ENDPOINT vazio = Amazon S3. Para outros provedores informe o endpoint e, se pedido,
# AWS_USE_PATH_STYLE_ENDPOINT=true.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- E-mail ----------------------------------------------------------------------
# Em dev "log" grava os e-mails no log. Em produção use smtp.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
# [OBRIGATÓRIO em produção]
MAIL_FROM_ADDRESS=nao-responda@suaempresa.com.br

# --- Privacidade (LGPD) -------------------------------------------------------------
# Aparecem no aviso de privacidade do portal "Trabalhe conosco" (/privacidade).
# Ao mudar o texto do aviso, aumente a versão: os novos aceites registram a versão nova.
PRIVACY_NOTICE_VERSION=2026.1
PRIVACY_NOTICE_UPDATED_AT=2026-11-27
PRIVACY_CONTROLLER="Hospital de Olhos CEOF"
# [RECOMENDADO] Encarregado de dados (DPO): nome e e-mail para os candidatos exercerem direitos.
PRIVACY_DPO_NAME=
PRIVACY_DPO_EMAIL=
# Meses que o currículo fica no banco de talentos (com consentimento) sem nova atividade.
PRIVACY_TALENT_POOL_MONTHS=24
# Meses para quem não autorizou o banco de talentos no portal, ou revogou a autorização
PRIVACY_NO_CONSENT_MONTHS=6
# Dias até anonimizar um cadastro excluído (permite desfazer exclusões por engano)
PRIVACY_DELETED_GRACE_DAYS=30
# Manter os dados de quem foi contratado (true) ou aplicar a mesma regra (false)
PRIVACY_KEEP_HIRED=true
# Meses de guarda da trilha de auditoria
PRIVACY_AUDIT_MONTHS=60
# Liga/desliga a anonimização automática diária (03:15)
PRIVACY_RETENTION_ENABLED=true

# Consulta de endereço pelo CEP (ViaCEP, com BrasilAPI de reserva). O servidor precisa
# de acesso à internet; sem ele, a pessoa só preenche cidade e UF à mão.
CEP_LOOKUP_ENABLED=true

# --- Backup ------------------------------------------------------------------------
# Diretório do HOST onde os backups são gravados (fora dos containers).
BACKUP_HOST_DIR=./backups
# Backup diário automático (padrão: desligado em dev, ligado em produção).
BACKUP_ENABLED=false
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=14
# [RECOMENDADO EM PRODUÇÃO] Cópia externa automática de cada backup para um bucket S3
# (AWS S3, Wasabi, Backblaze B2, Cloudflare R2, MinIO...). Vazio = desativada.
# Use um bucket e uma chave SÓ para backups, diferentes dos documentos.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=ceof-talent
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PATH_STYLE=false
# Dias de guarda na cópia externa (vazio = igual a BACKUP_RETENTION_DAYS; 0 = nunca apaga)
BACKUP_S3_RETENTION_DAYS=

# --- Desenvolvimento -----------------------------------------------------------------
# UID/GID do seu usuário no host (comando: id -u / id -g), para permissões do bind mount.
HOST_UID=1000
HOST_GID=1000

# --- Imagens (produção) ---------------------------------------------------------------
# Prefixo/tag das imagens construídas (ex.: registry.suaempresa.com.br/ceof-talent, v1.0.0)
IMAGE_PREFIX=ceof-talent
IMAGE_TAG=latest-local
