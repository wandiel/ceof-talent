# CEOF TALENT — Nginx de borda (DESENVOLVIMENTO)
# /api, /up e /sanctum -> PHP-FPM (app:9000)
# demais rotas         -> servidor Vite (frontend:5173) com HMR via WebSocket

upstream app_upstream      { server app:9000; }
upstream frontend_upstream { server frontend:5173; }

server {
    listen 8080 default_server;
    server_name _;

    include /etc/nginx/snippets/security-headers.conf;

    location = /nginx-health { access_log off; return 200 "ok\n"; add_header Content-Type text/plain; }

    location ~ ^/(api|up|sanctum)(/|$) {
        limit_req zone=api burst=50 nodelay;
        include /etc/nginx/snippets/laravel-fastcgi.conf;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }
}
